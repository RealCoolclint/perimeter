    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\n// Lieux considérés comme \"bureau\" — pas un déplacement.\n// Ajuste cette liste avec les noms exacts que tu utilises dans ton calendrier.\nconst officeLocations = [\"L'Étudiant\", \"Bureau\", \"Studio\"];\n\nlet totalMinutes = 0;\nlet hasFieldLocation = false;\n\nfor (const item of items) {\n  const event = item.json;\n\n  // On ignore les événements \"journée entière\" (anniversaires, etc.) — pas d'horaire précis\n  if (!event.start?.dateTime || !event.end?.dateTime) continue;\n\n  const start = new Date(event.start.dateTime);\n  const end = new Date(event.end.dateTime);\n  totalMinutes += (end - start) / 1000 / 60;\n\n  if (event.location && event.location.trim() !== \"\") {\n    const isOffice = officeLocations.some(loc =>\n      event.location.toLowerCase().includes(loc.toLowerCase())\n    );\n    if (!isOffice) hasFieldLocation = true;\n  }\n}\n\nconst totalHours = totalMinutes / 60;\nconst majorationReunions = totalHours > 4 ? 0.2 : 0;\nconst majorationTerrain = hasFieldLocation ? 0.3 : 0;\nconst poidsJournee = 1.0 + majorationReunions + majorationTerrain;\n\nreturn [{\n  json: {\n    date: new Date().toISOString().split('T')[0],\n    poids_journee: poidsJournee,\n    signaux: {\n      total_heures_reunions: Math.round(totalHours * 10) / 10,\n      journee_dense: majorationReunions > 0,\n      journee_terrain: majorationTerrain > 0\n    }\n  }\n}];"
      },
